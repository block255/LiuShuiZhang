<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+（API 31+）的数据提取声明：明确不把账单数据纳入
     云备份（cloud-backup）与换机迁移（device-transfer）。
     与 AndroidManifest 里的 android:allowBackup="false" 一起，保证"数据仅存本机"。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
